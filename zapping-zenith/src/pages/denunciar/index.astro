---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const categories = [
  "Contaminación del agua",
  "Contaminación del aire",
  "Manejo inadecuado de desechos",
  "Ruido excesivo",
  "Deforestación",
  "Contaminación visual",
  "Otro",
];
---

<BaseLayout
  title="Registrar denuncia | EcoAlerta MARN"
  description="Registra una denuncia ambiental con ubicación y evidencia."
>
  <Header />

  <main class="mx-auto max-w-4xl px-6 py-12 sm:py-16">
    <div class="mb-10">
      <a href="/" class="text-sm font-semibold text-emerald-700 hover:text-emerald-800">
        ← Volver al inicio
      </a>
      <p class="mt-5 text-sm font-bold uppercase tracking-widest text-emerald-700">
        Nueva denuncia
      </p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-950">
        Reporta un posible daño ambiental
      </h1>
      <p class="mt-4 max-w-2xl leading-7 text-slate-600">
        Proporciona información clara. Puedes enviar la denuncia de forma anónima.
      </p>
    </div>

    <form id="complaint-form" class="space-y-8">
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold">1. Tipo de denuncia</h2>

        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="category" class="mb-2 block text-sm font-semibold">
              Categoría <span class="text-red-600">*</span>
            </label>
            <select
              id="category"
              name="category"
              required
              class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100"
            >
              <option value="">Selecciona una categoría</option>
              {categories.map((category) => <option value={category}>{category}</option>)}
            </select>
          </div>

          <div>
            <label for="reported-party" class="mb-2 block text-sm font-semibold">
              Persona o empresa involucrada
            </label>
            <input
              id="reported-party"
              name="reportedParty"
              type="text"
              placeholder="Si la conoces"
              class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100"
            />
          </div>
        </div>

        <div class="mt-5">
          <label for="description" class="mb-2 block text-sm font-semibold">
            Describe lo sucedido <span class="text-red-600">*</span>
          </label>
          <textarea
            id="description"
            name="description"
            required
            minlength="20"
            rows="6"
            placeholder="Explica qué ocurrió, cuándo lo observaste y por qué consideras que afecta el ambiente."
            class="w-full resize-y rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100"
          ></textarea>
        </div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold">2. Ubicación</h2>

        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="department" class="mb-2 block text-sm font-semibold">
              Departamento <span class="text-red-600">*</span>
            </label>
            <input
              id="department"
              name="department"
              required
              placeholder="Ej. Guatemala"
              class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100"
            />
          </div>

          <div>
            <label for="municipality" class="mb-2 block text-sm font-semibold">
              Municipio <span class="text-red-600">*</span>
            </label>
            <input
              id="municipality"
              name="municipality"
              required
              placeholder="Ej. Mixco"
              class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100"
            />
          </div>
        </div>

        <div class="mt-5">
          <label for="address" class="mb-2 block text-sm font-semibold">
            Dirección o referencia <span class="text-red-600">*</span>
          </label>
          <input
            id="address"
            name="address"
            required
            placeholder="Zona, colonia, carretera, punto de referencia..."
            class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100"
          />
        </div>

        <button
          type="button"
          id="location-button"
          class="mt-5 rounded-xl border border-emerald-700 px-4 py-3 text-sm font-semibold text-emerald-700 hover:bg-emerald-50"
        >
          Usar mi ubicación actual
        </button>
        <p id="location-status" class="mt-2 text-sm text-slate-500"></p>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold">3. Evidencia multimedia</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Adjunta hasta 5 fotografías o videos. Máximo recomendado: 50 MB por archivo.
        </p>

        <label
          for="evidence"
          class="mt-5 flex cursor-pointer flex-col items-center rounded-2xl border-2 border-dashed border-emerald-300 bg-emerald-50 px-6 py-10 text-center hover:border-emerald-500"
        >
          <span class="text-3xl">📎</span>
          <span class="mt-3 font-semibold text-emerald-800">Seleccionar fotos o videos</span>
          <span class="mt-1 text-sm text-slate-600">JPG, PNG, WebP, MP4 o WebM</span>
        </label>

        <input
          id="evidence"
          name="evidence"
          type="file"
          accept="image/jpeg,image/png,image/webp,video/mp4,video/webm"
          multiple
          class="sr-only"
        />

        <div id="file-list" class="mt-5 grid gap-3 sm:grid-cols-2"></div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-start gap-3">
          <input
            id="anonymous"
            name="anonymous"
            type="checkbox"
            class="mt-1 size-4 accent-emerald-700"
          />
          <div>
            <label for="anonymous" class="font-semibold">Deseo realizar una denuncia anónima</label>
            <p class="mt-1 text-sm leading-6 text-slate-600">
              Si no marcas esta opción, solicitaremos tus datos de contacto en la siguiente versión del formulario.
            </p>
          </div>
        </div>
      </section>

      <p id="form-message" role="alert" class="hidden rounded-xl p-4 text-sm"></p>

      <button
        type="submit"
        class="w-full rounded-xl bg-emerald-700 px-6 py-4 font-bold text-white hover:bg-emerald-800 disabled:cursor-not-allowed disabled:bg-slate-400"
      >
        Continuar con la denuncia
      </button>
    </form>
  </main>

  <Footer />
</BaseLayout>

<script>
  const evidenceInput = document.querySelector("#evidence");
  const fileList = document.querySelector("#file-list");
  const locationButton = document.querySelector("#location-button");
  const locationStatus = document.querySelector("#location-status");
  const form = document.querySelector("#complaint-form");
  const formMessage = document.querySelector("#form-message");

  evidenceInput?.addEventListener("change", () => {
    const files = Array.from(evidenceInput.files ?? []);

    if (files.length > 5) {
      evidenceInput.value = "";
      fileList.innerHTML = "<p class='text-sm text-red-600'>Puedes adjuntar un máximo de 5 archivos.</p>";
      return;
    }

    fileList.innerHTML = files
      .map(
        (file) => `
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm">
            <p class="truncate font-semibold text-slate-800">${file.name}</p>
            <p class="mt-1 text-slate-500">${(file.size / 1024 / 1024).toFixed(2)} MB</p>
          </div>
        `,
      )
      .join("");
  });

  locationButton?.addEventListener("click", () => {
    if (!navigator.geolocation) {
      locationStatus.textContent = "Tu navegador no permite usar geolocalización.";
      return;
    }

    locationStatus.textContent = "Obteniendo ubicación...";

    navigator.geolocation.getCurrentPosition(
      (position) => {
        locationStatus.textContent =
          `Ubicación obtenida: ${position.coords.latitude.toFixed(5)}, ${position.coords.longitude.toFixed(5)}`;
      },
      () => {
        locationStatus.textContent = "No fue posible obtener la ubicación. Puedes indicar una referencia manual.";
      },
    );
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    formMessage.textContent =
      "Formulario validado. El siguiente paso será conectarlo a Supabase para guardar la denuncia y los archivos.";
    formMessage.className =
      "rounded-xl bg-amber-50 p-4 text-sm text-amber-800";
  });
</script>