---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
---

<BaseLayout title="Seguimiento de denuncia | MONAMI" description="Consulta el estado de una denuncia ambiental mediante su código de seguimiento.">
  <Header />
  <main class="mx-auto max-w-4xl px-6 py-12 sm:py-16">
    <section class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-emerald-700">Seguimiento ciudadano</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-950">Consulta el estado de tu denuncia</h1>
      <p class="mt-4 leading-7 text-slate-600">Ingresa el código único recibido al registrar tu denuncia. No necesitas iniciar sesión.</p>

      <form id="tracking-form" class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <label for="tracking-code" class="sr-only">Código de seguimiento</label>
        <div class="flex flex-col gap-3 sm:flex-row">
          <input id="tracking-code" name="trackingCode" type="text" required maxlength="40" placeholder="Ej. ECO-1A2B3C4D5E" class="w-full rounded-xl border border-slate-300 px-4 py-3 font-mono uppercase outline-none placeholder:font-sans placeholder:normal-case focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100" />
          <button type="submit" class="rounded-xl bg-emerald-700 px-6 py-3 font-semibold text-white hover:bg-emerald-800 disabled:cursor-wait disabled:bg-slate-400">Consultar</button>
        </div>
        <p id="tracking-error" role="alert" class="mt-3 hidden text-left text-sm text-red-600"></p>
      </form>
    </section>

    <section id="tracking-result" class="mt-12 hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8" aria-live="polite">
      <div class="flex flex-col gap-5 border-b border-slate-200 pb-6 sm:flex-row sm:items-start sm:justify-between">
        <div><p class="text-sm font-medium text-slate-500">Código de seguimiento</p><p id="result-code" class="mt-1 font-mono text-lg font-bold text-slate-950"></p></div>
        <span id="result-status" class="w-fit rounded-full bg-emerald-100 px-4 py-2 text-sm font-bold text-emerald-800"></span>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl bg-slate-50 p-4"><p class="text-sm text-slate-500">Categoría</p><p id="result-category" class="mt-1 font-semibold"></p></div>
        <div class="rounded-xl bg-slate-50 p-4"><p class="text-sm text-slate-500">Ubicación</p><p id="result-location" class="mt-1 font-semibold"></p></div>
        <div class="rounded-xl bg-slate-50 p-4"><p class="text-sm text-slate-500">Fecha de registro</p><p id="result-date" class="mt-1 font-semibold"></p></div>
      </div>
      <div class="mt-8">
        <h2 class="text-xl font-bold text-slate-950">Historial del caso</h2>
        <ol id="result-history" class="mt-6 space-y-6 border-l-2 border-emerald-200 pl-6"></ol>
      </div>
      <p class="mt-8 rounded-xl bg-slate-50 p-4 text-sm leading-6 text-slate-600">Por privacidad, esta consulta no muestra datos personales ni evidencia sensible.</p>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  import type { PublicReportResponse } from '../../contracts/reports'

  const statusLabels: Record<string, string> = {
    RECEIVED: 'Recibida', UNDER_REVIEW: 'En revisión', CLASSIFIED: 'Clasificada',
    INSPECTION_PENDING: 'Inspección pendiente', INSPECTION_COMPLETED: 'Inspección completada',
    REPORT_PENDING: 'Informe pendiente', CLOSED: 'Cerrada',
  }
  const form = document.querySelector<HTMLFormElement>('#tracking-form')
  const input = document.querySelector<HTMLInputElement>('#tracking-code')
  const errorMessage = document.querySelector<HTMLParagraphElement>('#tracking-error')
  const result = document.querySelector<HTMLElement>('#tracking-result')
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]')
  const setText = (selector: string, value: string) => { const element = document.querySelector<HTMLElement>(selector); if (element) element.textContent = value }

  function renderHistory(history: PublicReportResponse['history']) {
    const list = document.querySelector<HTMLOListElement>('#result-history')
    if (!list) return
    list.replaceChildren()
    for (const item of history) {
      const entry = document.createElement('li'); entry.className = 'relative'
      const marker = document.createElement('span'); marker.className = 'absolute -left-[33px] top-1 size-4 rounded-full bg-emerald-700 ring-4 ring-emerald-100'
      const title = document.createElement('p'); title.className = 'font-bold text-slate-950'; title.textContent = statusLabels[item.status] ?? item.status
      const message = document.createElement('p'); message.className = 'mt-1 text-sm text-slate-600'; message.textContent = item.message ?? 'Sin información adicional.'
      const date = document.createElement('time'); date.className = 'mt-2 block text-sm text-slate-500'; date.textContent = new Intl.DateTimeFormat('es-GT', { dateStyle: 'long', timeStyle: 'short' }).format(new Date(item.createdAt))
      entry.append(marker, title, message, date); list.append(entry)
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    const code = input?.value.trim().toUpperCase() ?? ''
    result?.classList.add('hidden')
    errorMessage?.classList.add('hidden')
    if (code.length < 6) {
      if (errorMessage) { errorMessage.textContent = 'Ingresa un código de seguimiento válido.'; errorMessage.classList.remove('hidden') }
      return
    }
    if (button) { button.disabled = true; button.textContent = 'Consultando...' }
    try {
      const response = await fetch(`/api/reports/tracking/${encodeURIComponent(code)}`)
      const data = await response.json() as PublicReportResponse & { error?: string }
      if (!response.ok) throw new Error(data.error ?? 'No se encontró una denuncia con ese código.')
      setText('#result-code', data.trackingCode)
      setText('#result-status', statusLabels[data.currentStatus] ?? data.currentStatus)
      setText('#result-category', data.category.name)
      setText('#result-location', `${data.department}, ${data.municipality}`)
      setText('#result-date', new Intl.DateTimeFormat('es-GT', { dateStyle: 'long' }).format(new Date(data.createdAt)))
      renderHistory(data.history)
      result?.classList.remove('hidden')
      result?.scrollIntoView({ behavior: 'smooth', block: 'start' })
    } catch (error) {
      if (errorMessage) { errorMessage.textContent = error instanceof Error ? error.message : 'No fue posible consultar la denuncia.'; errorMessage.classList.remove('hidden') }
    } finally {
      if (button) { button.disabled = false; button.textContent = 'Consultar' }
    }
  })

  const queryCode = new URLSearchParams(window.location.search).get('trackingCode')
  if (queryCode && input && form) { input.value = queryCode; form.requestSubmit() }
</script>
