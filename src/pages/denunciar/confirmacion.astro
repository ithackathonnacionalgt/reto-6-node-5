---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const trackingCode = Astro.url.searchParams.get("trackingCode") ?? "";
---

<BaseLayout
  title="Denuncia recibida | MONAMI"
  description="Confirmación del registro de tu denuncia ambiental."
>
  <Header />

  <main class="mx-auto max-w-2xl px-6 py-16 sm:py-24">
    <section class="rounded-3xl border border-emerald-200 bg-white p-8 text-center shadow-sm sm:p-12">
      <div class="mx-auto flex size-16 items-center justify-center rounded-full bg-emerald-100 text-3xl text-emerald-700" aria-hidden="true">✓</div>
      <p class="mt-6 text-sm font-bold uppercase tracking-widest text-emerald-700">Denuncia recibida</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Tu denuncia fue registrada correctamente</h1>
      <p class="mt-4 leading-7 text-slate-600">Guarda este código para consultar el estado de tu denuncia posteriormente.</p>

      {trackingCode ? (
        <p class="mt-8 rounded-2xl bg-slate-100 px-5 py-4 font-mono text-xl font-bold tracking-wide text-slate-950">{trackingCode}</p>
      ) : (
        <p class="mt-8 rounded-2xl bg-amber-50 px-5 py-4 text-sm text-amber-800">No se encontró el código de seguimiento.</p>
      )}

      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/seguimiento" class="rounded-xl bg-emerald-700 px-5 py-3 font-semibold text-white hover:bg-emerald-800">Consultar denuncia</a>
        <a href="/" class="rounded-xl border border-slate-300 px-5 py-3 font-semibold text-slate-700 hover:bg-slate-50">Volver al inicio</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
