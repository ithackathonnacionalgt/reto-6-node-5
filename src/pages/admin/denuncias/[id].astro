---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import { getAuthContext } from '../../../lib/auth/admin-guard'

const auth = await getAuthContext(Astro)
if (!auth) return Astro.redirect('/admin/login')
const reportId = Astro.params.id ?? ''
---

<AdminLayout title="Detalle de denuncia" email={auth.user.email ?? 'Usuario institucional'} role={auth.role}>
  <main id="report-detail-page" data-report-id={reportId} class="mx-auto max-w-7xl px-6 py-10">
    <a href="/admin" class="text-sm font-semibold text-emerald-700 hover:text-emerald-900">← Volver al listado</a>
    <div id="detail-loading" class="mt-8 rounded-2xl border border-slate-200 bg-white p-8 text-center text-slate-600 shadow-sm">Cargando denuncia...</div>
    <p id="detail-error" class="mt-8 hidden rounded-2xl bg-red-50 p-5 text-red-700" role="alert"></p>

    <div id="detail-content" class="mt-8 hidden space-y-6">
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div><p class="text-sm text-slate-500">Código de seguimiento</p><h1 id="detail-code" class="mt-1 font-mono text-2xl font-bold text-slate-950"></h1></div>
          <span id="detail-status" class="w-fit rounded-full bg-emerald-100 px-4 py-2 text-sm font-bold text-emerald-800"></span>
        </div>
        <dl class="mt-6 grid gap-5 border-t border-slate-200 pt-6 sm:grid-cols-2 lg:grid-cols-4">
          <div><dt class="text-sm text-slate-500">Categoría</dt><dd id="detail-category" class="mt-1 font-semibold"></dd></div>
          <div><dt class="text-sm text-slate-500">Departamento</dt><dd id="detail-department" class="mt-1 font-semibold"></dd></div>
          <div><dt class="text-sm text-slate-500">Municipio</dt><dd id="detail-municipality" class="mt-1 font-semibold"></dd></div>
          <div><dt class="text-sm text-slate-500">Fecha</dt><dd id="detail-date" class="mt-1 font-semibold"></dd></div>
        </dl>
      </section>

      <div class="grid gap-6 lg:grid-cols-3">
        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
          <h2 class="text-xl font-bold">Información de la denuncia</h2>
          <dl class="mt-5 space-y-5">
            <div><dt class="text-sm font-semibold text-slate-500">Descripción</dt><dd id="detail-description" class="mt-1 whitespace-pre-wrap leading-7"></dd></div>
            <div><dt class="text-sm font-semibold text-slate-500">Referencia de ubicación</dt><dd id="detail-reference" class="mt-1"></dd></div>
            <div><dt class="text-sm font-semibold text-slate-500">Empresa o persona denunciada</dt><dd id="detail-company" class="mt-1"></dd></div>
          </dl>
        </section>
        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-xl font-bold">Denunciante</h2>
          <dl class="mt-5 space-y-4">
            <div><dt class="text-sm text-slate-500">Tipo</dt><dd id="detail-anonymous" class="mt-1 font-semibold"></dd></div>
            <div><dt class="text-sm text-slate-500">Nombre</dt><dd id="detail-reporter" class="mt-1"></dd></div>
            <div><dt class="text-sm text-slate-500">Correo</dt><dd id="detail-email" class="mt-1 break-all"></dd></div>
          </dl>
        </section>
      </div>

      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold">Ubicación</h2>
        <p id="detail-coordinates" class="mt-2 text-sm text-slate-600"></p>
        <div class="mt-5 overflow-hidden rounded-2xl border border-slate-200"><div id="detail-map" class="h-80 w-full"></div></div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold">Evidencia</h2>
        <p class="mt-2 text-sm text-slate-600">Los enlaces son privados y tienen una vigencia limitada.</p>
        <div id="detail-media" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
      </section>

      <div class="grid gap-6 lg:grid-cols-2">
        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-xl font-bold">Historial de estados</h2>
          <ol id="detail-history" class="mt-6 space-y-6 border-l-2 border-emerald-200 pl-6"></ol>
        </section>

        {auth.role === 'ADMIN' && (
          <section class="h-fit rounded-2xl border border-emerald-200 bg-emerald-50 p-6 shadow-sm">
            <h2 class="text-xl font-bold">Actualizar estado</h2>
            <p class="mt-2 text-sm text-slate-600">El cambio y su mensaje quedarán registrados en el historial.</p>
            <form id="status-form" class="mt-5 space-y-4">
              <div>
                <label for="next-status" class="mb-2 block text-sm font-semibold">Nuevo estado</label>
                <select id="next-status" required class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3">
                  <option value="RECEIVED">Recibida</option><option value="UNDER_REVIEW">En revisión</option><option value="CLASSIFIED">Clasificada</option><option value="INSPECTION_PENDING">Inspección pendiente</option><option value="INSPECTION_COMPLETED">Inspección completada</option><option value="REPORT_PENDING">Informe pendiente</option><option value="CLOSED">Cerrada</option>
                </select>
              </div>
              <div>
                <label for="status-message" class="mb-2 block text-sm font-semibold">Mensaje explicativo</label>
                <textarea id="status-message" required rows="4" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3" placeholder="Describe brevemente la actualización."></textarea>
              </div>
              <p id="status-message-result" class="hidden rounded-xl p-3 text-sm" role="alert"></p>
              <button type="submit" class="rounded-xl bg-emerald-700 px-5 py-3 font-bold text-white hover:bg-emerald-800 disabled:opacity-50">Guardar actualización</button>
            </form>
          </section>
        )}
      </div>
    </div>
  </main>
</AdminLayout>

<script>
  import L from 'leaflet'
  import 'leaflet/dist/leaflet.css'

  interface ReportDetail {
    id: string; tracking_code: string; current_status: string; created_at: string; updated_at: string
    description: string; department: string; municipality: string; location_reference: string
    latitude: number; longitude: number; reported_company: string | null; is_anonymous: boolean
    reporter_name: string | null; reporter_email: string | null
    categories: { name: string } | null
    report_media: Array<{ id: string; media_type: string; signedUrl: string | null }>
    status_history: Array<{ id: string; status: string; message: string | null; created_at: string }>
  }
  const labels: Record<string, string> = { RECEIVED: 'Recibida', UNDER_REVIEW: 'En revisión', CLASSIFIED: 'Clasificada', INSPECTION_PENDING: 'Inspección pendiente', INSPECTION_COMPLETED: 'Inspección completada', REPORT_PENDING: 'Informe pendiente', CLOSED: 'Cerrada' }
  const page = document.querySelector<HTMLElement>('#report-detail-page')
  const reportId = page?.dataset.reportId ?? ''
  const setText = (selector: string, value: string) => { const element = document.querySelector<HTMLElement>(selector); if (element) element.textContent = value }
  let detailMap: L.Map | null = null

  function renderMap(latitude: number, longitude: number) {
    const mapElement = document.querySelector<HTMLDivElement>('#detail-map')
    if (!mapElement || detailMap) return
    detailMap = L.map(mapElement).setView([latitude, longitude], 16)
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors', maxZoom: 19 }).addTo(detailMap)
    L.circleMarker([latitude, longitude], { radius: 10, color: '#047857', fillColor: '#10b981', fillOpacity: 0.85 }).addTo(detailMap).bindPopup('Ubicación reportada')
  }

  function renderMedia(items: ReportDetail['report_media']) {
    const container = document.querySelector<HTMLDivElement>('#detail-media')
    if (!container) return
    container.replaceChildren()
    for (const item of items) {
      if (!item.signedUrl) continue
      const card = document.createElement('div')
      card.className = 'overflow-hidden rounded-xl border border-slate-200 bg-slate-50'
      const media = item.media_type.startsWith('video/') ? document.createElement('video') : document.createElement('img')
      media.className = 'h-56 w-full object-cover'
      media.src = item.signedUrl
      if (media instanceof HTMLVideoElement) { media.controls = true; media.preload = 'metadata' } else media.alt = 'Evidencia de la denuncia'
      card.append(media)
      container.append(card)
    }
    if (!container.childElementCount) container.textContent = 'Esta denuncia no tiene evidencia disponible.'
  }

  function renderHistory(items: ReportDetail['status_history']) {
    const history = document.querySelector<HTMLOListElement>('#detail-history')
    if (!history) return
    history.replaceChildren()
    for (const item of [...items].sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime())) {
      const entry = document.createElement('li')
      entry.className = 'relative'
      const marker = document.createElement('span')
      marker.className = 'absolute -left-[33px] top-1 size-4 rounded-full bg-emerald-700 ring-4 ring-emerald-100'
      const title = document.createElement('p'); title.className = 'font-bold'; title.textContent = labels[item.status] ?? item.status
      const message = document.createElement('p'); message.className = 'mt-1 text-sm text-slate-600'; message.textContent = item.message ?? 'Sin mensaje adicional.'
      const date = document.createElement('time'); date.className = 'mt-2 block text-xs text-slate-500'; date.textContent = new Intl.DateTimeFormat('es-GT', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(item.created_at))
      entry.append(marker, title, message, date); history.append(entry)
    }
  }

  async function loadDetail() {
    try {
      const response = await fetch(`/api/admin/reports/${encodeURIComponent(reportId)}`)
      if (response.status === 401) return window.location.assign('/admin/login')
      const data = await response.json() as ReportDetail & { error?: string }
      if (!response.ok) throw new Error(data.error ?? 'No se pudo cargar la denuncia.')
      setText('#detail-code', data.tracking_code); setText('#detail-status', labels[data.current_status] ?? data.current_status)
      setText('#detail-category', data.categories?.name ?? 'Sin categoría'); setText('#detail-department', data.department); setText('#detail-municipality', data.municipality)
      setText('#detail-date', new Intl.DateTimeFormat('es-GT', { dateStyle: 'long' }).format(new Date(data.created_at)))
      setText('#detail-description', data.description); setText('#detail-reference', data.location_reference); setText('#detail-company', data.reported_company ?? 'No indicada')
      setText('#detail-anonymous', data.is_anonymous ? 'Anónima' : 'Identificada'); setText('#detail-reporter', data.is_anonymous ? 'Información protegida' : data.reporter_name ?? 'No indicado')
      setText('#detail-email', data.is_anonymous ? 'Información protegida' : data.reporter_email ?? 'No indicado')
      setText('#detail-coordinates', `${data.latitude.toFixed(6)}, ${data.longitude.toFixed(6)}`)
      renderMap(data.latitude, data.longitude); renderMedia(data.report_media ?? []); renderHistory(data.status_history ?? [])
      const select = document.querySelector<HTMLSelectElement>('#next-status'); if (select) select.value = data.current_status
      document.querySelector('#detail-loading')?.classList.add('hidden'); document.querySelector('#detail-content')?.classList.remove('hidden')
    } catch (error) {
      document.querySelector('#detail-loading')?.classList.add('hidden')
      const message = document.querySelector<HTMLParagraphElement>('#detail-error')
      if (message) { message.textContent = error instanceof Error ? error.message : 'Error inesperado.'; message.classList.remove('hidden') }
    }
  }

  document.querySelector<HTMLFormElement>('#status-form')?.addEventListener('submit', async (event) => {
    event.preventDefault()
    const form = event.currentTarget
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')
    const result = document.querySelector<HTMLParagraphElement>('#status-message-result')
    const status = document.querySelector<HTMLSelectElement>('#next-status')?.value ?? ''
    const message = document.querySelector<HTMLTextAreaElement>('#status-message')?.value.trim() ?? ''
    if (button) button.disabled = true
    try {
      const response = await fetch(`/api/admin/reports/${encodeURIComponent(reportId)}/status`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ status, message }) })
      const body = await response.json() as { error?: string }
      if (response.status === 401) return window.location.assign('/admin/login')
      if (!response.ok) throw new Error(body.error ?? 'No se pudo actualizar el estado.')
      if (result) { result.textContent = 'Estado actualizado correctamente.'; result.className = 'block rounded-xl bg-emerald-100 p-3 text-sm text-emerald-800' }
      document.querySelector<HTMLTextAreaElement>('#status-message')!.value = ''
      await loadDetail()
    } catch (error) {
      if (result) { result.textContent = error instanceof Error ? error.message : 'Error inesperado.'; result.className = 'block rounded-xl bg-red-100 p-3 text-sm text-red-800' }
    } finally { if (button) button.disabled = false }
  })

  void loadDetail()
</script>
