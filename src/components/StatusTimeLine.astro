---
interface Props {
  currentStep?: number;
}

const { currentStep = 1 } = Astro.props;

const steps = [
  {
    title: "Denuncia registrada",
    description: "Tu reporte fue recibido y se generó tu código de seguimiento.",
  },
  {
    title: "Análisis inicial",
    description: "El equipo responsable revisa la información y la evidencia.",
  },
  {
    title: "En gestión",
    description: "La denuncia está siendo atendida o trasladada al área correspondiente.",
  },
  {
    title: "Caso resuelto",
    description: "El proceso finalizó y el resultado fue registrado.",
  },
];
---

<ol class="space-y-0">
  {
    steps.map((step, index) => {
      const stepNumber = index + 1;
      const isComplete = stepNumber < currentStep;
      const isCurrent = stepNumber === currentStep;

      return (
        <li class="relative grid grid-cols-[3rem_1fr] gap-4 pb-8 last:pb-0">
          <div class="relative flex justify-center">
            {index < steps.length - 1 && (
              <span
                class:list={[
                  "absolute top-11 h-full w-0.5",
                  isComplete ? "bg-emerald-600" : "bg-slate-200",
                ]}
              ></span>
            )}

            <span
              class:list={[
                "z-10 grid size-10 place-items-center rounded-full border-2 text-sm font-bold",
                isComplete && "border-emerald-700 bg-emerald-700 text-white",
                isCurrent && "border-emerald-700 bg-emerald-100 text-emerald-800 ring-4 ring-emerald-50",
                !isComplete && !isCurrent && "border-slate-300 bg-white text-slate-500",
              ]}
            >
              {isComplete ? "✓" : stepNumber}
            </span>
          </div>

          <div class="pt-1">
            <p class:list={["font-bold", isCurrent ? "text-emerald-800" : "text-slate-900"]}>
              {step.title}
            </p>
            <p class="mt-1 text-sm leading-6 text-slate-600">{step.description}</p>

            {isCurrent && (
              <span class="mt-3 inline-flex rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800">
                Estado actual
              </span>
            )}
          </div>
        </li>
      );
    })
  }
</ol>